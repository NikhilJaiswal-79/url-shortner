{
  "name": "url-shortener",
  "version": "1.0.0",
  "type": "module",
  "description": "URL Shortener Service - Demonstrates all 7 Kiro Lessons",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --coverage",
    "test:property": "jest tests/property",
    "test:unit": "jest tests/unit",
    "lint": "eslint src/"
  },
  "keywords": ["url-shortener", "kiro", "lessons"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "nanoid": "^3.3.6",
    "valid-url": "^1.0.9"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "fast-check": "^3.13.0",
    "eslint": "^8.50.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  }
}